# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=backend
DB_PASSWORD=change-me
DB_NAME=api_db

# TypeORM schema auto-sync. Leave false outside local development:
# when enabled, TypeORM issues DDL on every boot and will drop columns
# that no longer appear on an entity.
DB_SYNC=false

# Required. The app refuses to start without it.
JWT_SECRET=change-me

# HTTP port (defaults to 3000)
PORT=3000

# --- voice assistant (ESP32 pipeline) ---
# Speech in and out. Defaults point at the live voicebox deployment.
VOICEBOX_URL=https://voicebox.server.arifhosan.me
VOICEBOX_PROFILE_ID=660fa6cc-0d56-4e28-9260-d130548a75be
VOICEBOX_TTS_ENGINE=kokoro
# Optional: leave unset to use voicebox's configured transcription model.
VOICEBOX_STT_MODEL=

# The OpenAI-compatible relay that answers. No key is needed today.
MODELRELAY_URL=https://modelrelay.server.arifhosan.me
MODELRELAY_MODEL=auto-fastest
MODELRELAY_API_KEY=

VOICE_LANGUAGE=en
VOICE_SYSTEM_PROMPT=
VOICE_MAX_TOKENS=200

# Shared bearer secret devices must present. Unset disables authentication.
VOICE_AUTH_TOKEN=
VOICE_WS_PATH=/voice/ws
# Override when the advertised URL cannot be derived from the request host.
VOICE_PUBLIC_WS_URL=

VOICE_DOWNLINK_SAMPLE_RATE=24000
VOICE_MAX_HISTORY_TURNS=8
VOICE_SILENCE_MS=900
VOICE_MIN_UTTERANCE_MS=400
VOICE_MAX_UTTERANCE_MS=15000
VOICE_HELLO_TIMEOUT_MS=10000
VOICE_IDLE_TIMEOUT_MS=300000
