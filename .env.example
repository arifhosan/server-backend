# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=backend
DB_PASSWORD=change-me
DB_NAME=api_db

# TypeORM schema auto-sync. Leave false outside local development:
# when enabled, TypeORM issues DDL on every boot and will drop columns
# that no longer appear on an entity.
DB_SYNC=false

# Required. The app refuses to start without it.
JWT_SECRET=change-me

# HTTP port (defaults to 3000)
PORT=3000
