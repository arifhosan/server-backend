{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Tracker",
  "version": "0.1.0",
  "identifier": "me.arifhosan.gametracker",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Game Tracker",
        "width": 360,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "TODO-OWNER-REPLACE-WITH-CONTENTS-OF-gametracker.key.pub (see tracker/README.md)",
      "endpoints": ["https://github.com/ArifHosan/server-backend/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
